# ClassPilot Backend - Environment Variables

# ================================
# قاعدة البيانات
# ================================
# استبدل اليوزرنيم وكلمة المرور واسم قاعدة البيانات
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/classpilot?schema=public"

# ================================
# JWT Secrets
# ================================
# يجب أن تكون عشوائية وطويلة (على الأقل 64 حرف)
# يمكن توليدها بالأمر: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_DIFFERENT_FROM_ABOVE"

# مدة صلاحية Access Token (15 دقيقة بالافتراضي)
JWT_ACCESS_EXPIRES_IN="15m"

# مدة صلاحية Refresh Token (7 أيام بالافتراضي)
JWT_REFRESH_EXPIRES_IN="7d"

# ================================
# إعدادات الخادم
# ================================
PORT=3000
NODE_ENV="development"

# URL الـFrontend للـCORS (فصل متعدد بفاصلة)
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# ================================
# QR Code
# ================================
# مدة صلاحية رمز QR بالثواني (5 دقائق بالافتراضي)
QR_EXPIRY_SECONDS=300

# مفتاح سري لتوقيع بيانات QR
QR_SECRET="CHANGE_ME_TO_A_QR_SIGNING_SECRET"

# ================================
# Rate Limiting
# ================================
# عدد الطلبات المسموح بها لكل IP في النافذة الزمنية
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# حد أكثر صرامة لنقاط المصادقة
AUTH_RATE_LIMIT_MAX=10

# ================================
# Upload (اختياري - للمستقبل)
# ================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"
