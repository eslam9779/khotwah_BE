            "url": { "raw": "{{base_url}}/files", "host": ["{{base_url}}"], "path": ["files"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Algebra Worksheet\",\n  \"description\": \"Practice problems chapter 5\",\n  \"fileType\": \"DOCUMENT\",\n  \"fileUrl\": \"https://example.com/worksheet.pdf\",\n  \"isParentVisible\": false,\n  \"isStudentVisible\": true\n}" }
          }
        }
      ]
