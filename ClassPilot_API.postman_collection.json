    {
      "name": "👪 Parents",
      "item": [
        {
          "name": "Teacher — Create Invitation",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const json = pm.response.json();",
            "  pm.collectionVariables.set('invite_token', json.data.token);",
            "  console.log('Invite token saved:', json.data.token);",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/parents/teacher/invitations", "host": ["{{base_url}}"], "path": ["parents", "teacher", "invitations"] },
            "body": { "mode": "raw", "raw": "{\n  \"studentId\": \"{{student_id}}\",\n  \"canViewAttendance\": true,\n  \"canViewGrades\": true,\n  \"canViewPayments\": false,\n  \"canViewAssessments\": false,\n  \"canViewFiles\": true\n}" }
          }
        },
        {
          "name": "Teacher — List Student Links",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/parents/teacher/students/{{student_id}}/links", "host": ["{{base_url}}"], "path": ["parents", "teacher", "students", "{{student_id}}", "links"] }
          }
        },
        {
          "name": "Parent — Accept Invitation",
          "description": "Login as a PARENT account first, then use that token here",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer PARENT_TOKEN_HERE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/parents/parent/invitations/accept", "host": ["{{base_url}}"], "path": ["parents", "parent", "invitations", "accept"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{invite_token}}\"\n}" }
          }
        },
        {
          "name": "Parent — My Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer PARENT_TOKEN_HERE" }],
            "url": { "raw": "{{base_url}}/parents/parent/my-students", "host": ["{{base_url}}"], "path": ["parents", "parent", "my-students"] }
          }
        }
      ]
    },
